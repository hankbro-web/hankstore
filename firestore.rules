rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isDelivery() {
      return signedIn()
        && exists(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)).data.active == true;
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /deliveryInvites/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create, update, delete: if isAdmin();
    }

    match /deliveryBoys/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/deliveryInvites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/deliveryInvites/$(request.auth.token.email)).data.active == true
      );
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
      );
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if signedIn();
      allow read: if isAdmin() || (isDelivery() && resource.data.deliveryBoyUid == request.auth.uid);
      allow update: if isAdmin() || (
        isDelivery()
        && resource.data.deliveryBoyUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deliveryUpdatedAt'])
      );
      allow delete: if isAdmin();
    }
  }
}